# ── Required ──
DATABASE_URL=postgres://mgt:change-me@localhost:5432/mgt
APP_BASE_URL=http://localhost:3000
# Private storage for PDFs/videos (persistent volume in production)
STORAGE_DIR=./storage

# ── Site privacy (trial) ──
# When set, every page asks for this shared password (HTTP Basic auth) and search engines are told not to index.
SITE_ACCESS_USER=preview
SITE_ACCESS_PASSWORD=
SITE_NOINDEX=true

# ── Email (verification + password reset). Leave empty until a provider is configured. ──
SMTP_HOST=
SMTP_PORT=587
SMTP_USER=
SMTP_PASSWORD=
EMAIL_FROM="Medical Global Tricks <no-reply@example.com>"

# ── Stripe (leave empty until the company account is approved) ──
STRIPE_SECRET_KEY=
STRIPE_WEBHOOK_SECRET=

# Bootstrap: this email becomes admin when running `npm run make-admin`.
ADMIN_EMAIL=
